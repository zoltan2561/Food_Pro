<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass bearer tokens through to Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Installation and database updates are performed with Artisan, not over HTTP.
    RewriteRule ^(?:index\.php/)?(?:install|update)(?:/|$) - [F,NC,L]

    # Only the Laravel front controller may execute PHP.
    RewriteRule ^index\.php$ - [L]
    RewriteRule \.(?:php[0-9]?|phtml|pht|phar)(?:\.|/|$) - [F,NC,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.(?!well-known$)">
    Require all denied
</FilesMatch>
